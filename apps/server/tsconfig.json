{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    /* Dead code is a correctness signal, not just clutter: every one of the
       six the strip left behind was a demo-era constant that no longer meant
       anything, and nothing flagged them. Now the typecheck does. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    /* The lamport arithmetic is the arcade's own JavaScript, vendored verbatim
       -- see tools/vendor-arcade.mjs. checkJs stays off deliberately: that file
       is not ours to make strict-clean, and editing it to satisfy this compiler
       would be exactly the drift the copy exists to prevent. */
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@zinc/engine": ["../../packages/engine/src/index.ts"]
    }
  },
  "include": ["src", "vendor", "test"]
}

# THIN ICE — every environment variable the code reads.
# Copy to apps/server/.env (server) or apps/web/.env.local (web) as needed.
# Nothing here is a secret; the house key is generated at runtime and gitignored.

# ---------------------------------------------------------------- game server
# Port the websocket/health server listens on.
PORT=8787

# SQLite file. One file holds balances, rounds, entries and transfers.
DB_PATH=zinc.db

# Devnet play credit granted to a wallet the first time it is seen.
# Set to 0 once real deposits are the only way in.
STARTING_BALANCE=5

# A round needs this many entrants to seal. Below it the lobby rolls over.
# There are no bots, so this is genuinely how many humans must show up.
MIN_ENTRANTS=2

# Solana cluster the house wallet banks on. Devnet only: the server refuses to
# start against mainnet, because the custodial hot wallet is not a mainnet design.
RPC_URL=https://api.devnet.solana.com

# Where the house keypair lives. Generated on first boot if absent. GITIGNORED.
HOUSE_KEYPAIR_PATH=house-keypair.json

# ----------------------------------------------------------------------- web
# Point the site at a server. UNSET = the local single-player demo.
# VITE_SERVER_URL=ws://127.0.0.1:8787

# RPC the browser uses to submit deposits. Defaults to devnet.
# VITE_RPC_URL=https://api.devnet.solana.com

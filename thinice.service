# THIN ICE, on the box.
#
#   sudo cp thinice.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl restart thinice
#   journalctl -fu thinice
#
# This unit was hand-written on the machine and existed nowhere else, which
# meant a box rebuild lost it and nobody could review what the live server was
# actually being told. It is in the repository now.

[Unit]
Description=THIN ICE -- crash game server
# The arcade holds the books this game moves money in, and this process fails
# closed without them: it wants gielinor up, but does not require it, because a
# ledger that is briefly down should mean "no stakes for a minute" and not "the
# game server is also down and takes a manual restart".
After=network-online.target gielinor.service
Wants=network-online.target gielinor.service

[Service]
Type=simple
User=thinice
WorkingDirectory=/opt/thinice
ExecStart=/usr/bin/npm run server
Restart=always
RestartSec=3

Environment=NODE_ENV=production
Environment=PORT=8787
Environment=DB_PATH=/var/lib/thinice/zinc.db

# -- the arcade's books ------------------------------------------------------
#
# ARCADE_LEDGER_URL and ARCADE_AUTH_URL, in ONE file shared with
# gielinor.service and cursors.service.
#
# LEDGER_KEY IS NO LONGER IN THAT FILE. It is "the whole authority to move
# anybody's money on this box", and an environment variable is readable from
# /proc/<pid>/environ by anything that can touch this process, besides living
# in a plaintext file shared across units. It now arrives as a systemd
# credential instead: a root-owned 0400 file bound in at /run/credentials,
# outside the environment and out of arcade.env. The app reads it through
# LEDGER_KEY_FILE below. Put the raw key in /etc/arcade/ledger_key on the box:
#
#   sudo install -m 0400 -o root /dev/null /etc/arcade/ledger_key
#   sudoedit /etc/arcade/ledger_key      # paste the key, save, exit
#
# and DELETE the LEDGER_KEY line from /etc/arcade/arcade.env once every unit
# has moved over (rotation day, not today).
#
# THE URLS ARE LOOPBACK AND MUST STAY LOOPBACK. apps/server/src/arcade.ts
# refuses to start if a key is set and the ledger URL is not on 127.0.0.1,
# because posting a service key to a public origin is a compromise that looks
# exactly like ordinary traffic. Caddy terminates TLS in front of both
# processes, so they are already on the same machine.
#
# No `-` prefix on either line: a missing env file OR a missing key file must
# stop this unit rather than bring up a server that looks healthy and refuses
# every stake.
LoadCredential=ledger_key:/etc/arcade/ledger_key
Environment=LEDGER_KEY_FILE=%d/ledger_key
EnvironmentFile=/etc/arcade/arcade.env

# The database is this game's own -- rounds, seats, chat. Not money: money is
# the arcade's, and `players.balance` was dropped by migration.
StateDirectory=thinice
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

# WHAT THIS PROCESS MAY DO, WHICH IS NEARLY NOTHING.
#
# Matched to gielinor.service, which is the unit these three sit beside on the
# same box. The reasoning is written out there in full; the short version is that
# a process which answers HTTP and writes one database has no business reaching
# any of the below, and a compromised Node process is exactly what this bounds.

# ITS OWN DATABASE IS NOT WORLD-READABLE. Without UMask= a service inherits 0022,
# so node creates the database 0644 -- readable by every other account on this
# box, including the other games. These databases hold balances and, in Thin
# Ice's case, the bearer tokens that ARE a player's identity.
UMask=0077

# Nothing here binds a port below 1024, so no capability is needed at all.
CapabilityBoundingSet=
AmbientCapabilities=

PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# Other processes become invisible. ProcSubset=pid is deliberately NOT set: it
# also hides /proc/stat, where Node reads CPU information.
ProtectProc=invisible

# AF_NETLINK is in the list because glibc's getaddrinfo uses it to enumerate
# interfaces; without it DNS fails in a way that looks like the network being down.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# MemoryDenyWriteExecute IS DELIBERATELY ABSENT, here as in gielinor.service: V8
# compiles JavaScript to machine code at runtime and needs pages that are
# writable and then executable, so it would not harden this service, it would
# stop it booting.

# ProtectSystem=strict was missing entirely, so this service could write anywhere
# its user could reach -- including /opt/thinice, the tree it runs FROM, which
# turns any file-write bug into something that survives a restart. Its database
# lives under StateDirectory=thinice, which stays writable on its own.
ProtectSystem=strict

# NO OUTBOUND NETWORK, NOW ENFORCED. DEPLOYMENT.md has always promised that
# this process talks to its database, to the arcade on loopback, and to
# nothing else; this is the line pair that makes the promise true instead of
# aspirational. Everything -- inbound and outbound -- must be loopback: nginx
# reaches :8787 from localhost, the ledger and auth edges are 127.0.0.1, and
# there is no third conversation to have. A compromised process can no longer
# phone home, scan the box's neighbours, or exfiltrate anything off-machine.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target

# THIN ICE — every environment variable the code reads.
# Copy to apps/server/.env (server) or apps/web/.env.local (web) as needed.
# Nothing here is a secret. This game holds no key material of any kind: see
# the note on custody below.

# ---------------------------------------------------------------- game server
# Port the websocket/health server listens on.
PORT=8787

# SQLite file. Holds rounds, entries and player profiles -- NOT balances.
# Money lives in the arcade's shared ledger, which every game reads and no
# game owns.
DB_PATH=zinc.db

# A round needs this many DISTINCT wallets to seal. Below it the lobby rolls
# over until real players arrive.
MIN_ENTRANTS=2

# Plates one wallet may hold in a single round (multi-betting cap).
MAX_PLATES_PER_WALLET=5

# Minutes away before auto play switches itself off. Auto is an intent for a
# sitting, not a standing order: without this, a player who closed the tab
# with auto on is staked into a live round the instant they return hours
# later. Wide enough that a refresh or a dropped connection keeps the
# setting. 0 disables lapsing (auto then persists forever).
AUTO_LAPSE_MIN=10

# ------------------------------------------------------------------- custody
# There is nothing to configure here, and that is the design.
#
# This game does not deposit, does not withdraw, holds no house keypair and
# opens no RPC connection. It moves numbers in the arcade's ledger and
# nothing else. Money enters and leaves the arcade at ONE edge, which lives
# with the arcade and not with any game -- so a bug in a game can misprice a
# round, but it can never sign a transfer.
#
# It used to be otherwise: this server generated its own hot wallet on first
# boot and paid withdrawals from it. Six games doing that is six hot wallets,
# six deposit verifiers and six chances to get double-crediting wrong.

# ----------------------------------------------------------------------- web
# Point the site at a server. UNSET = the local single-player demo.
# VITE_SERVER_URL=ws://127.0.0.1:8787

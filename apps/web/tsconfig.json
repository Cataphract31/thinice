{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    /* Dead code is a correctness signal, not just clutter: every one of the
       six the strip left behind was a demo-era constant that no longer meant
       anything, and nothing flagged them. Now the typecheck does. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@zinc/engine": ["../../packages/engine/src/index.ts"],
      /* The arcade's wallet is fetched from this same site at RUNTIME and is
         not a file in this repo -- see serveArcade() in vite.config.ts. The
         compiler still wants a shape for it, and an ambient `declare module`
         cannot supply one: those match BARE specifiers only, and this is a
         path. Mapping it here is what makes the URL typecheck. */
      "/arcade/web/wallet.js": ["./src/types/arcade.d.ts"]
    }
  },
  "include": ["src"]
}
